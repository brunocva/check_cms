# Copie este arquivo para ".env.local" e preencha com os valores do seu projeto Supabase
# (Project Settings -> API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Usada para montar links de redirecionamento de e-mail (confirmação de cadastro e reset de senha).
# Em produção, use a URL pública do seu deploy na Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave de admin do projeto (Project Settings -> API Keys -> service_role).
# NUNCA prefixar com NEXT_PUBLIC_ e nunca importar em código 'use client' —
# ela ignora RLS e tem acesso total ao projeto. Usada só para confirmar a
# conta automaticamente no cadastro (lib/actions/auth.ts), sem depender do
# envio de e-mail de confirmação.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta
